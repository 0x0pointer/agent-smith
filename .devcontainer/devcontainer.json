{
  // agent-smith dev container for GitHub Codespaces.
  // The harness (agent-smith, MCP server, Claude Code, opencode) runs NATIVELY here,
  // exactly like your local box. Only the hacking tools run in a container.
  // Backend: Claude only (no local model, no DGX Spark).
  //
  // Codespaces secrets (Settings -> Codespaces -> Secrets):
  //   ANTHROPIC_API_KEY  OR  CLAUDE_CODE_OAUTH_TOKEN   -> Claude auth
  //   TS_AUTH_KEY                                       -> Tailscale (reach the lab + receive callbacks)
  "name": "agent-smith",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // docker-in-docker: runs ONLY the hacking-tools container(s)
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // Tailscale: joins the Codespace to your lab tailnet for bidirectional reachability
    "ghcr.io/tailscale/codespace/tailscale:1": {},
    // opencode needs Node 18+
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  // If tailscaled complains about /dev/net/tun, uncomment:
  // "runArgs": ["--device=/dev/net/tun"],

  // ── Ports (SECURITY-SENSITIVE — this is offensive tooling) ────────────────
  // Keep EVERY port PRIVATE (the Codespaces default: reachable only by you, via a
  // GitHub-authenticated URL). NEVER switch these to Public:
  //   7778  MCP SSE server   — drives all tools; public = RCE-as-a-service
  //   5001  Kali API         — command execution surface
  //   1080/8888/8889/11601   — SOCKS/chisel-C2/HTTP-file-server/ligolo listeners
  //   7777  dashboard        — control plane that steers a permission-skipping agent
  // Targets/lab reach the tunnel & C2 listeners over TAILSCALE (the tools container
  // runs on the host network / tailnet), NOT via Codespaces forwarding — point
  // reverse shells at the Codespace tailnet IP. Only the dashboard is forwarded for
  // convenience; open the tokenized URL (…/#k=<token>) that the scan prints.
  "forwardPorts": [7777],
  "portsAttributes": {
    "7777":  { "label": "agent-smith dashboard (open the tokenized URL the scan prints)", "onAutoForward": "notify" },
    "7778":  { "label": "MCP SSE — local only, do NOT expose", "onAutoForward": "ignore" },
    "5001":  { "label": "Kali API — internal, do NOT expose", "onAutoForward": "ignore" },
    "1080":  { "label": "SOCKS5 (chisel) — reach via Tailscale", "onAutoForward": "silent" },
    "8888":  { "label": "chisel C2 — reach via Tailscale", "onAutoForward": "silent" },
    "8889":  { "label": "HTTP file server — reach via Tailscale", "onAutoForward": "silent" },
    "11601": { "label": "ligolo-ng — reach via Tailscale", "onAutoForward": "silent" }
  },
  // Silence every other auto-forwarded port (docker-proxy, VS Code internals) so the
  // Ports panel isn't noise; they stay private regardless.
  "otherPortsAttributes": { "onAutoForward": "silent" },

  "hostRequirements": { "cpus": 8, "memory": "16gb", "storage": "64gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": { "vscode": { "extensions": ["anthropic.claude-code"] } }
}
