diff --git a/smith_cli.py b/smith_cli.py
new file mode 100644
index 0000000..2b50f3d
--- /dev/null
+++ b/smith_cli.py
@@ -0,0 +1,27 @@
+from __future__ import annotations
+
+import argparse
+import json
+
+from control_plane import orchestrator
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="smith")
+    sub = parser.add_subparsers(dest="command", required=True)
+    sub.add_parser("start")
+    sub.add_parser("stop")
+    sub.add_parser("status")
+    args = parser.parse_args(argv)
+
+    if args.command == "start":
+        print(json.dumps(orchestrator.start_control_plane()))
+    elif args.command == "stop":
+        print(json.dumps(orchestrator.stop_control_plane()))
+    else:
+        print(json.dumps(orchestrator.control_plane_status()))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/test_container_isolation.py b/tests/test_container_isolation.py
new file mode 100644
index 0000000..41ebabd
--- /dev/null
+++ b/tests/test_container_isolation.py
@@ -0,0 +1,65 @@
+import core.session.lifecycle as lifecycle
+from tools import kali_runner, metasploit_runner, mobsf_runner
+
+
+def test_kali_run_uses_run_scoped_name_network_and_ephemeral_port(monkeypatch):
+    monkeypatch.setenv("SMITH_RUN_ID", "Run A")
+    monkeypatch.delenv("SMITH_SINGLE_RUN", raising=False)
+
+    kali_runner.remember_api_port(41001)
+
+    assert kali_runner.container_name() == "smith-kali-run-a"
+    assert kali_runner.network_name() == "smith-run-run-a"
+    assert kali_runner.api_publish_arg() == "127.0.0.1::5000"
+    assert kali_runner.api_url() == "http://127.0.0.1:41001"
+
+
+def test_two_run_apis_do_not_collide(monkeypatch):
+    monkeypatch.delenv("SMITH_SINGLE_RUN", raising=False)
+
+    monkeypatch.setenv("SMITH_RUN_ID", "run-a")
+    kali_runner.remember_api_port(41001)
+    metasploit_runner.remember_api_port(41002)
+    mobsf_runner.remember_api_port(41003)
+    urls_a = {
+        kali_runner.api_url(),
+        metasploit_runner.api_url(),
+        mobsf_runner.api_url(),
+    }
+
+    monkeypatch.setenv("SMITH_RUN_ID", "run-b")
+    kali_runner.remember_api_port(42001)
+    metasploit_runner.remember_api_port(42002)
+    mobsf_runner.remember_api_port(42003)
+    urls_b = {
+        kali_runner.api_url(),
+        metasploit_runner.api_url(),
+        mobsf_runner.api_url(),
+    }
+
+    assert urls_a.isdisjoint(urls_b)
+    assert kali_runner.container_name() == "smith-kali-run-b"
+    assert metasploit_runner.container_name() == "smith-metasploit-run-b"
+    assert mobsf_runner.container_name() == "smith-mobsf-run-b"
+
+
+def test_stop_only_current_run_containers(monkeypatch):
+    seen = {}
+
+    def _fake_run(argv, **kwargs):
+        seen["argv"] = argv
+        class _Proc:
+            returncode = 0
+        return _Proc()
+
+    monkeypatch.delenv("SMITH_KEEP_CONTAINERS", raising=False)
+    monkeypatch.delenv("SMITH_SINGLE_RUN", raising=False)
+    monkeypatch.setenv("SMITH_RUN_ID", "run-a")
+    monkeypatch.setattr("subprocess.run", _fake_run)
+
+    lifecycle.stop_pentest_containers()
+
+    assert "smith-kali-run-a" in seen["argv"]
+    assert "smith-metasploit-run-a" in seen["argv"]
+    assert "smith-mobsf-run-a" in seen["argv"]
+    assert "smith-kali-run-b" not in seen["argv"]
diff --git a/tests/test_control_plane.py b/tests/test_control_plane.py
new file mode 100644
index 0000000..6117f86
--- /dev/null
+++ b/tests/test_control_plane.py
@@ -0,0 +1,52 @@
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from control_plane import orchestrator
+from core import db as db_store
+
+
+def test_create_run_inserts_row_and_starts_worker(monkeypatch, tmp_path):
+    db_path = tmp_path / "runs.db"
+    monkeypatch.setenv("SMITH_DATABASE_URL", f"sqlite:///{db_path}")
+
+    with patch("subprocess.Popen", return_value=MagicMock(pid=4321)):
+        created = orchestrator.create_run({"target": "https://a.example", "depth": "recon"})
+
+    listed = orchestrator.list_runs()
+    assert created["run_id"].startswith("run-")
+    assert listed[0]["run_id"] == created["run_id"]
+    assert listed[0]["status"] == "running"
+
+
+def test_concurrent_create_two_runs(monkeypatch, tmp_path):
+    db_path = tmp_path / "runs.db"
+    monkeypatch.setenv("SMITH_DATABASE_URL", f"sqlite:///{db_path}")
+
+    with patch("subprocess.Popen", side_effect=[MagicMock(pid=1), MagicMock(pid=2)]):
+        run_a = orchestrator.create_run({"target": "https://a.example", "depth": "recon"})
+        run_b = orchestrator.create_run({"target": "https://b.example", "depth": "recon"})
+
+    rows = orchestrator.list_runs()
+    assert run_a["run_id"] != run_b["run_id"]
+    assert {row["run_id"] for row in rows} == {run_a["run_id"], run_b["run_id"]}
+
+
+def test_create_run_validation_400(monkeypatch, tmp_path):
+    db_path = tmp_path / "runs.db"
+    monkeypatch.setenv("SMITH_DATABASE_URL", f"sqlite:///{db_path}")
+
+    with pytest.raises(ValueError):
+        orchestrator.create_run({"target": "", "depth": "bogus"})
+
+
+def test_docker_failure_marks_failed_and_cleans(monkeypatch, tmp_path):
+    db_path = tmp_path / "runs.db"
+    monkeypatch.setenv("SMITH_DATABASE_URL", f"sqlite:///{db_path}")
+
+    with patch("subprocess.Popen", side_effect=OSError("docker failed")):
+        with pytest.raises(OSError):
+            orchestrator.create_run({"target": "https://broken.example", "depth": "recon"})
+
+    rows = orchestrator.list_runs()
+    assert rows[0]["status"] == "failed"
