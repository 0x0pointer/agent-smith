-# ── FTS5 index ────────────────────────────────────────────────────────────
-_SCHEMA = """
-CREATE VIRTUAL TABLE IF NOT EXISTS kb_docs USING fts5(
-    source UNINDEXED, kind UNINDEXED, title, tags UNINDEXED, body, untrusted UNINDEXED);
-CREATE TABLE IF NOT EXISTS kb_meta(
