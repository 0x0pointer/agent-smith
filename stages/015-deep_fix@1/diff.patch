+    repo = db_store.get_repository()
+    repo.save_snapshot(run_a["run_id"], "findings", {"findings": [{"title": "SQLi A"}]})
+    repo.save_snapshot(run_a["run_id"], "session", {"target": "https://a.example", "status": "running"})
